# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
GIN_MODE=debug
ENVIRONMENT=development

# Database Configuration (Single default fallback)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=hostel_management
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Kolkata
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Dual-Pool Database Roles Configuration (Sprint 1 Step 2)
# College Application Pool (Restricted role for tenant operational queries: hms_college_app)
DB_COLLEGE_USER=hms_college_app
DB_COLLEGE_PASSWORD=your_college_password_here
DB_COLLEGE_MAX_CONNS=25
DB_COLLEGE_MIN_CONNS=5

# Platform Application Pool (Restricted role for platform control plane: hms_platform_app)
DB_PLATFORM_USER=hms_platform_app
DB_PLATFORM_PASSWORD=your_platform_password_here
DB_PLATFORM_MAX_CONNS=5
DB_PLATFORM_MIN_CONNS=1

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_HOURS=168
JWT_ISSUER=hostel-management-system

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@hostelmgmt.com
SMTP_FROM_NAME=Hostel Management System

# SMS Configuration (Twilio example)
SMS_ACCOUNT_SID=your_twilio_account_sid
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_FROM_NUMBER=+1234567890

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/jpg,application/pdf
STORAGE_PATH=./STORAGE

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_GENERAL_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=5

# Telegram Alerts
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ALERT_COOLDOWN_SECONDS=300
TELEGRAM_ALERT_TIMEOUT_SECONDS=5

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/app.log

# Frontend URLs
STUDENT_WEB_URL=http://localhost:5173
PARENT_WEB_URL=http://localhost:5174
ADMIN_WEB_URL=http://localhost:5175
INCHARGE_WEB_URL=http://localhost:5176
SECURITY_WEB_URL=http://localhost:5177
SUPER_ADMIN_WEB_URL=http://localhost:5178

# Render.com specific (for production)
# DATABASE_URL=postgresql://user:password@host:port/database
# REDIS_URL=redis://host:port
