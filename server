#!/bin/sh
if [ -f "./server." ]; then
    chmod +x "./server." 2>/dev/null || true
    exec "./server." "$@"
fi

if [ -f "./server.exe" ]; then
    chmod +x "./server.exe" 2>/dev/null || true
    exec "./server.exe" "$@"
fi

if command -v go >/dev/null 2>&1; then
    go build -o /tmp/hms-backend-bin .
    chmod +x /tmp/hms-backend-bin
    exec /tmp/hms-backend-bin "$@"
fi

echo "Binary not found"
exit 1
