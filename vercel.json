{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace=MODULES/SUPER-ADMIN/FRONTEND/WEB",
  "outputDirectory": "MODULES/SUPER-ADMIN/FRONTEND/WEB/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "https://hms-1-mjvj.onrender.com/auth/$1"
    },
    {
      "source": "/super-admin/(.*)",
      "destination": "https://hms-1-mjvj.onrender.com/super-admin/$1"
    },
    {
      "source": "/geo/(.*)",
      "destination": "https://hms-1-mjvj.onrender.com/geo/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

