# Super Admin Control Plane Frontend Environment Variables

# Base URL of the backend API
# In local development, leave blank to use the Vite dev proxy ('http://localhost:8080')
# For Vercel production deployment, set to your production API origin:
# e.g. VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=

# Vite dev-server proxy target for the local Go API
VITE_BACKEND_TARGET=http://localhost:8080
